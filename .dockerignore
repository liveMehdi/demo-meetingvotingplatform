# Only build inputs belong in the Docker context.
**
!Dockerfile
!package.json
!package-lock.json
!apps/
!apps/web/
!apps/web/package.json
!apps/web/index.html
!apps/web/tsconfig.json
!apps/web/vite.config.ts
!apps/web/src/
!apps/web/src/**
!apps/web/public/
!apps/web/public/**
!apps/api/
!apps/api/pyproject.toml
!apps/api/uv.lock
!apps/api/alembic.ini
!apps/api/app/
!apps/api/app/**
!apps/api/migrations/
!apps/api/migrations/**
# Apply these even inside an allowed source directory.
**/__pycache__/
**/*.py[cod]
**/.env
**/.env.*
**/*.dump
**/*.log
**/*.pem
**/*.key
